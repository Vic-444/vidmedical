---
import Layout from '../layouts/Layout.astro';

const tier = Astro.url.searchParams.get('tier') ?? '';
const tierValue =
  tier === 'essential' ? 'Essential' : tier === 'advanced' ? 'Advanced' : tier === 'monthly' ? 'Monthly retainer' : '';
---

<Layout
  title="VidMedical — Medical explainer videos for health practices"
  description="VidMedical Studio creates short medical explainer videos for Instagram Reels, YouTube Shorts, and TikTok — ready for health practices to post."
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-ink text-paper">
    <div
      class="hero-orb pointer-events-none absolute -left-24 top-[-20%] h-[28rem] w-[28rem] rounded-full bg-signal/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="hero-orb pointer-events-none absolute -right-20 bottom-[-35%] h-[22rem] w-[22rem] rounded-full bg-signal/10 blur-3xl [animation-delay:-4s]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.14]"
      style="background-image: linear-gradient(rgba(251,252,252,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(251,252,252,0.07) 1px, transparent 1px); background-size: 48px 48px;"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto flex min-h-[88vh] max-w-6xl flex-col justify-center px-5 py-20 md:px-8 md:py-28">
      <p class="animate-rise font-sans text-xs font-semibold uppercase tracking-[0.22em] text-signal-bright">
        VidMedical Studio
      </p>
      <h1
        class="animate-rise-delay-1 mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.08] tracking-tight text-paper sm:text-5xl md:text-6xl lg:text-[4.15rem]"
      >
        Medical explainer videos for practices that post.
      </h1>
      <p class="animate-rise-delay-2 mt-6 max-w-xl text-base leading-relaxed text-fog/80 md:text-lg">
        We create short vertical explainers for doctors, dentists, physiotherapists, coaches, and
        clinics — polished, medically thoughtful, and ready for Instagram Reels, YouTube Shorts, and
        TikTok, so your clinic days can stay focused on patients.
      </p>
      <div class="animate-rise-delay-3 mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#pricing"
          class="inline-flex rounded-full bg-signal px-6 py-3 text-sm font-semibold text-ink no-underline transition hover:bg-signal-bright"
        >
          See pricing
        </a>
        <a
          href="#start"
          class="inline-flex rounded-full border border-paper/25 px-6 py-3 text-sm font-semibold text-paper no-underline transition hover:border-paper/50 hover:bg-paper/5"
        >
          Start an order
        </a>
      </div>
      <div class="signal-line mt-16 h-px max-w-xs bg-gradient-to-r from-signal-bright via-signal/40 to-transparent"></div>
    </div>
  </section>

  <!-- What we do -->
  <section class="bg-paper" id="offer">
    <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">What we do</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        Clear medical shorts made for social.
      </h2>
      <p class="mt-4 max-w-2xl text-muted leading-relaxed">
        We produce procedure walkthroughs, biomechanics explainers, treatment education, and
        patient-facing clips designed for Instagram Reels, YouTube Shorts, and TikTok. Every video
        is delivered in a vertical 9:16 aspect ratio at 1080×1920 pixels, so it is ready to upload
        without reformatting — and each piece goes through physician-led QA before you post. You can
        work with us on talking-head footage, voiceover-led pieces, or a blend of both — whichever
        fits how your practice likes to teach.
      </p>

      <div class="mt-12 grid gap-10 border-t border-ink/10 pt-10 md:grid-cols-2 md:gap-12">
        <div>
          <h3 class="font-display text-xl font-semibold text-ink">Essential</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            A clean, professional edit of the material you send us — thoughtful pacing, readable
            captions, tuned audio, and carefully chosen clinical B-roll that supports the message.
          </p>
          <div class="mt-6 mx-auto w-full max-w-[17.5rem]">
            <div class="relative aspect-[9/16] overflow-hidden bg-ink/95 shadow-[0_24px_60px_-28px_rgba(12,20,25,0.55)]">
              <iframe
                class="absolute inset-0 h-full w-full border-0"
                src="https://www.youtube-nocookie.com/embed/7R7hyLHEUVQ"
                title="VidMedical Essential Edit — Sample Showreel"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              >
              </iframe>
            </div>
            <p class="mt-3 text-center text-xs text-muted">
              <a
                class="font-medium text-signal no-underline hover:text-signal-bright"
                href="https://www.youtube.com/shorts/7R7hyLHEUVQ"
                target="_blank"
                rel="noopener noreferrer"
              >
                Watch Essential sample
              </a>
            </p>
          </div>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold text-ink">Advanced</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            A richer edit for topics that benefit from motion graphics and anatomical visuals —
            overlays, mechanism-style moments, and 2D/3D elements that help patients understand
            complex ideas more easily.
          </p>
          <div class="mt-6 mx-auto w-full max-w-[17.5rem]">
            <div class="relative aspect-[9/16] overflow-hidden bg-ink/95 shadow-[0_24px_60px_-28px_rgba(12,20,25,0.55)]">
              <iframe
                class="absolute inset-0 h-full w-full border-0"
                src="https://www.youtube-nocookie.com/embed/nxbDHNHelRk"
                title="VidMedical Advanced Edit — Sample Showreel"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              >
              </iframe>
            </div>
            <p class="mt-3 text-center text-xs text-muted">
              <a
                class="font-medium text-signal no-underline hover:text-signal-bright"
                href="https://www.youtube.com/shorts/nxbDHNHelRk"
                target="_blank"
                rel="noopener noreferrer"
              >
                Watch Advanced sample
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified client feedback -->
  <section class="bg-mist" id="feedback">
    <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">Client feedback</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        Verified notes from healthcare work.
      </h2>
      <p class="mt-4 max-w-2xl text-muted leading-relaxed">
        Real client feedback from completed projects, lightly edited for clarity.
      </p>

      <div class="mt-12 grid gap-10 border-t border-ink/10 pt-10 md:grid-cols-3 md:gap-8">
        <blockquote class="flex flex-col">
          <p class="font-display text-lg leading-relaxed text-ink md:text-xl">
            “Excellent work in science and medicine — clear communication, on schedule, and
            consistently high quality.”
          </p>
          <footer class="mt-6 text-sm font-medium text-muted">
            — Verified Biotech Client
          </footer>
        </blockquote>
        <blockquote class="flex flex-col border-t border-ink/10 pt-10 md:border-t-0 md:border-l md:pt-0 md:pl-8">
          <p class="font-display text-lg leading-relaxed text-ink md:text-xl">
            “Phenomenal to work with — careful with the key details and proactive with the content.
            A real pleasure.”
          </p>
          <footer class="mt-6 text-sm font-medium text-muted">
            — Verified Social Content Client
          </footer>
        </blockquote>
        <blockquote class="flex flex-col border-t border-ink/10 pt-10 md:border-t-0 md:border-l md:pt-0 md:pl-8">
          <p class="font-display text-lg leading-relaxed text-ink md:text-xl">
            “Very professional and dedicated to getting the work done correctly.”
          </p>
          <footer class="mt-6 text-sm font-medium text-muted">
            — Verified Healthcare Video Client
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Pricing tiers -->
  <section class="bg-paper" id="pricing">
    <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">Pricing</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        Two clear tiers for the work you need.
      </h2>
      <p class="mt-4 max-w-2xl text-muted leading-relaxed">
        Choose Essential or Advanced for each video, or mix both in the same order when your content
        calendar calls for it. Orders of five or more videos receive a 10% discount, and we are
        happy to discuss monthly retainers by email.
      </p>

      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        <article class="flex flex-col border border-ink/10 bg-paper p-6 md:p-8">
          <a
            href="/?tier=essential#start"
            class="inline-flex w-fit rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper no-underline transition hover:bg-ink-soft"
          >
            Start Essential
          </a>
          <p class="mt-10 text-xs font-semibold uppercase tracking-[0.16em] text-muted">Essential</p>
          <p class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink">$67</p>
          <p class="mt-1 text-sm text-muted">per video</p>
          <p class="mt-6 text-sm leading-relaxed text-ink-soft">
            We build on the brief, voiceover or script, and footage you provide — refining pace,
            captions, audio, and supporting B-roll into a polished short ready for social.
          </p>
          <ul class="mt-8 space-y-3 text-sm leading-relaxed text-ink-soft">
            <li>Vertical 9:16 delivery at 1080×1920 pixels</li>
            <li>Two rounds of revisions included</li>
            <li>Optional short-form script add-on for $30</li>
          </ul>
          <a
            href="/?tier=essential#start"
            class="mt-10 inline-flex justify-center rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper no-underline transition hover:bg-ink-soft"
          >
            Start Essential
          </a>
        </article>

        <article class="flex flex-col border-2 border-signal bg-paper p-6 md:p-8">
          <a
            href="/?tier=advanced#start"
            class="inline-flex w-fit rounded-full bg-signal px-5 py-2.5 text-sm font-semibold text-ink no-underline transition hover:bg-signal-bright"
          >
            Start Advanced
          </a>
          <p class="mt-10 text-xs font-semibold uppercase tracking-[0.16em] text-signal">Advanced</p>
          <p class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink">$199</p>
          <p class="mt-1 text-sm text-muted">per video</p>
          <p class="mt-6 text-sm leading-relaxed text-ink-soft">
            We build on the brief and assets you provide, then layer in motion graphics and
            anatomical visuals so more technical topics — procedures, mechanisms, and detailed
            explanations — feel clear and engaging on a phone screen.
          </p>
          <ul class="mt-8 space-y-3 text-sm leading-relaxed text-ink-soft">
            <li>Vertical 9:16 delivery at 1080×1920 pixels</li>
            <li>Two rounds of revisions included</li>
            <li>Optional short-form script add-on for $50</li>
          </ul>
          <a
            href="/?tier=advanced#start"
            class="mt-10 inline-flex justify-center rounded-full bg-signal px-5 py-2.5 text-sm font-semibold text-ink no-underline transition hover:bg-signal-bright"
          >
            Start Advanced
          </a>
        </article>
      </div>

      <p class="mt-10">
        <a
          href="/?tier=essential#start"
          class="inline-flex rounded-full border border-ink/20 bg-transparent px-5 py-2.5 text-sm font-semibold text-ink no-underline transition hover:border-signal hover:text-signal"
        >
          Start with a single video
        </a>
      </p>

      <p class="mt-8 text-sm leading-relaxed text-muted">
        If you would like a short-form voiceover script written for the video, the script add-on is
        available on either tier. For a monthly content block or a mix of Essential and Advanced
        videos,&nbsp;<a href="/?tier=monthly#start" class="font-medium text-signal no-underline hover:text-ink">get in touch and we will shape a retainer with you</a>.
      </p>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-mist" id="process">
    <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">How it works</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        From inquiry to ready-to-post files.
      </h2>
      <p class="mt-4 max-w-2xl text-muted leading-relaxed">
        The process is simple and stays in email, so you can describe what you need, share your
        materials when you are ready, and keep clinic days free of long meetings.
      </p>

      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <li>
          <span class="font-display text-4xl font-semibold text-signal/40">01</span>
          <h3 class="mt-2 font-semibold text-ink">Inquire</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Use the form below to briefly describe what you want and what you will provide — that
            is enough for us to start the conversation.
          </p>
        </li>
        <li>
          <span class="font-display text-4xl font-semibold text-signal/40">02</span>
          <h3 class="mt-2 font-semibold text-ink">Share your materials</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            We reply within 24 hours. You can then send your brief, links, and attachments by email
            in the same thread.
          </p>
        </li>
        <li>
          <span class="font-display text-4xl font-semibold text-signal/40">03</span>
          <h3 class="mt-2 font-semibold text-ink">Align and pay</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Together we confirm the scope in writing, then we send a Payoneer invoice. Production
            begins once payment is received, the brief is approved, and your assets are in.
          </p>
        </li>
        <li>
          <span class="font-display text-4xl font-semibold text-signal/40">04</span>
          <h3 class="mt-2 font-semibold text-ink">Draft delivery</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            We share drafts through a Drive link for your review. Turnaround details live in the FAQ
            below so you always know what to expect.
          </p>
        </li>
        <li>
          <span class="font-display text-4xl font-semibold text-signal/40">05</span>
          <h3 class="mt-2 font-semibold text-ink">Revisions</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Two rounds of revisions are included with every video, and we work from your notes until
            the piece feels right.
          </p>
        </li>
        <li>
          <span class="font-display text-4xl font-semibold text-signal/40">06</span>
          <h3 class="mt-2 font-semibold text-ink">Finals</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            We deliver ready-to-post files so you can publish with confidence on the channels your
            practice already uses.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-paper" id="faq">
    <div class="mx-auto max-w-3xl px-5 py-20 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">FAQ</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        A few details that often come up.
      </h2>

      <div class="mt-12 space-y-0 divide-y divide-ink/10 border-y border-ink/10">
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              How long does delivery take?
              <span class="text-signal transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Once payment is in, the brief is approved, and your assets have arrived, we deliver up
            to three Essential videos per week, or up to two Advanced videos per week. For example,
            five Essential videos would typically arrive as three in the first week and two in the
            second. The timeline covers our production window; the time you spend reviewing a draft
            sits outside that schedule, so you can take the care you need.
          </p>
        </details>
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              Refunds and trying us first
              <span class="text-signal transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Once an order is paid, we are unable to offer refunds. Every video includes two rounds of
            revisions so we can work toward a cut you are happy to post. If you would like to try the
            service first, begin with a single video — and if you are happy with the result, we can
            move into a bulk order or a monthly arrangement from there.
          </p>
        </details>
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              Bulk orders and monthly retainers
              <span class="text-signal transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Orders of five or more videos receive a 10% discount. Monthly retainers can combine
            Essential and Advanced videos to match the mix your calendar needs — write to us and we
            will scope a block that fits.
          </p>
        </details>
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              What should you send us?
              <span class="text-signal transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            A short brief, your script or voiceover (unless you would like the script add-on), and
            the footage or reference materials for the piece. After we reply to your inquiry, you
            can send files and links comfortably by email.
          </p>
        </details>
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              Script writing
              <span class="text-signal transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            If you would like us to write a short-form voiceover script for the video, the add-on is
            $30 on Essential and $50 on Advanced. Advanced scripts often need a little more
            technical research, which is reflected in the price.
          </p>
        </details>
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              Payment methods
              <span class="text-signal transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Once we have agreed on the scope, we send a Payoneer invoice by email. The invoice
            includes several payment options, including credit card and PayPal, so you can choose
            whatever is most convenient.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Start / contact -->
  <section class="bg-mist" id="start">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 pt-24 pb-20 md:grid-cols-[1fr_1.1fr] md:px-8 md:pt-32 md:pb-28">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">Start</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl">
          Tell us what you have in mind.
        </h2>
        <p class="mt-5 max-w-md text-muted leading-relaxed">
          A short note is enough to begin — which tier you are considering, roughly how many
          videos, and what you will provide. We will reply within 24 hours from
          <a href="mailto:hello@vidmedical.com" class="font-medium text-signal no-underline hover:text-ink">
            hello@vidmedical.com
          </a>, and we can gather the full brief together by email from there.
        </p>
      </div>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="border border-ink/10 bg-mist p-6 md:p-8"
      >
        <input type="hidden" name="access_key" value="685d2384-6522-49e4-aa53-a06b709865d2" />
        <input type="hidden" name="subject" value="VidMedical — new inquiry" />
        <input type="hidden" name="from_name" value="VidMedical Studio" />
        <input type="hidden" name="redirect" value="https://vidmedical.com/thanks" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <label class="block text-sm font-medium text-ink">
          Name
          <input
            required
            type="text"
            name="name"
            class="mt-2 w-full border border-ink/15 bg-paper px-3 py-2.5 text-sm text-ink outline-none focus:border-signal"
          />
        </label>

        <label class="mt-5 block text-sm font-medium text-ink">
          Email
          <input
            required
            type="email"
            name="email"
            class="mt-2 w-full border border-ink/15 bg-paper px-3 py-2.5 text-sm text-ink outline-none focus:border-signal"
          />
        </label>

        <label class="mt-5 block text-sm font-medium text-ink">
          Practice / role
          <input
            type="text"
            name="practice"
            placeholder="e.g. physio clinic, dental practice, coach"
            class="mt-2 w-full border border-ink/15 bg-paper px-3 py-2.5 text-sm text-ink outline-none focus:border-signal"
          />
        </label>

        <label class="mt-5 block text-sm font-medium text-ink">
          Interest
          <select
            id="interest"
            name="interest"
            class="mt-2 w-full border border-ink/15 bg-paper px-3 py-2.5 text-sm text-ink outline-none focus:border-signal"
          >
            <option value="" disabled selected={!tierValue}>Select…</option>
            <option value="Essential" selected={tierValue === 'Essential'}>Essential</option>
            <option value="Advanced" selected={tierValue === 'Advanced'}>Advanced</option>
            <option value="Monthly retainer" selected={tierValue === 'Monthly retainer'}>
              Monthly retainer
            </option>
            <option value="Custom / not sure">Custom / not sure</option>
          </select>
        </label>

        <label class="mt-5 block text-sm font-medium text-ink">
          What you want and what you will provide
          <textarea
            required
            name="message"
            rows="5"
            placeholder="For example: two Essential videos; I will send phone footage and a rough outline…"
            class="mt-2 w-full resize-y border border-ink/15 bg-paper px-3 py-2.5 text-sm text-ink outline-none focus:border-signal"
          >{tierValue ? `Interested in: ${tierValue}\n\n` : ''}</textarea>
        </label>

        <button
          type="submit"
          class="mt-7 w-full rounded-full bg-signal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-signal-bright"
        >
          Send inquiry
        </button>
      </form>
    </div>
  </section>
</Layout>
