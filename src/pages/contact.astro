---
import Layout from '../layouts/Layout.astro';

const tier = Astro.url.searchParams.get('tier') ?? Astro.url.searchParams.get('interest') ?? '';
const dest =
  tier === 'essential' || tier === 'single'
    ? '/?tier=essential#start'
    : tier === 'advanced'
      ? '/?tier=advanced#start'
      : tier === 'core' || tier === 'growth' || tier === 'monthly'
        ? '/?tier=monthly#start'
        : '/#start';
---

<Layout title="Contact — VidMedical" description="Start an order on the VidMedical homepage.">
  <section class="bg-mist">
    <div class="mx-auto max-w-2xl px-5 py-20 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">Contact</p>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink">
        Start from the homepage.
      </h1>
      <p class="mt-4 text-muted leading-relaxed">
        The inquiry form lives on the main page so pricing, process, and start stay together.
      </p>
      <p class="mt-8">
        <a
          href={dest}
          class="inline-flex rounded-full bg-signal px-5 py-3 text-sm font-semibold text-ink no-underline transition hover:bg-signal-bright"
        >
          Go to start
        </a>
      </p>
    </div>
  </section>
  <script is:inline define:vars={{ dest }}>
    location.replace(dest);
  </script>
</Layout>
