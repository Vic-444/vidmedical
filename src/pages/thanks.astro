---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Message sent — VidMedical"
  description="Thanks for contacting VidMedical. We’ll reply by email."
>
  <section class="bg-mist">
    <div class="mx-auto max-w-2xl px-5 py-20 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">Contact</p>
      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink md:text-5xl">
        Message sent.
      </h1>
      <p class="mt-5 text-muted leading-relaxed">
        Thanks for reaching out. We’ll reply by email from
        <span class="text-ink">hello@vidmedical.com</span> — usually within one business day.
      </p>
      <p class="mt-10">
        <a
          href="/"
          class="inline-flex rounded-full bg-signal px-5 py-3 text-sm font-semibold text-ink no-underline transition hover:bg-signal-bright"
        >
          Back to home
        </a>
      </p>
    </div>
  </section>
</Layout>
