---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Packages — VidMedical" description="Pricing lives on the VidMedical homepage.">
  <section class="bg-mist">
    <div class="mx-auto max-w-2xl px-5 py-20 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-signal">Packages</p>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink">
        Pricing is on the homepage.
      </h1>
      <p class="mt-4 text-muted leading-relaxed">
        Essential and Advanced tiers, process, and start form are all on
        <a href="/#pricing" class="font-medium text-signal no-underline hover:text-ink">vidmedical.com</a>.
      </p>
      <p class="mt-8">
        <a
          href="/#pricing"
          class="inline-flex rounded-full bg-signal px-5 py-3 text-sm font-semibold text-ink no-underline transition hover:bg-signal-bright"
        >
          Go to pricing
        </a>
      </p>
    </div>
  </section>
  <script is:inline>
    location.replace('/#pricing');
  </script>
</Layout>
