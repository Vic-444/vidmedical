---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-ink text-fog">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 md:flex-row md:items-end md:justify-between md:px-8">
    <div>
      <a href="/" class="inline-flex items-center gap-3 no-underline">
        <img
          src="/brand/vidmedical-mark.svg"
          alt=""
          width="40"
          height="40"
          class="h-10 w-10 shrink-0 rounded-[0.65rem]"
        />
        <span class="font-display text-2xl font-semibold tracking-tight text-paper">
          VidMedical Studio
        </span>
      </a>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-fog/75">
        Short medical explainer videos for health practices — polished, clear, and ready to post on
        Reels, Shorts, and TikTok.
      </p>
    </div>
    <div class="flex flex-col gap-3 text-sm">
      <a href="/#pricing" class="text-fog/85 no-underline hover:text-signal-bright">Pricing</a>
      <a href="/#process" class="text-fog/85 no-underline hover:text-signal-bright">Process</a>
      <a href="/about" class="text-fog/85 no-underline hover:text-signal-bright">About</a>
      <a href="/#start" class="text-fog/85 no-underline hover:text-signal-bright">Start</a>
      <a href="mailto:hello@vidmedical.com" class="text-fog/85 no-underline hover:text-signal-bright">
        hello@vidmedical.com
      </a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl px-5 py-5 text-xs text-fog/55 md:px-8">
      <p>© {year} VidMedical Studio. All rights reserved.</p>
    </div>
  </div>
</footer>
