---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-ink text-fog">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 md:flex-row md:items-end md:justify-between md:px-8">
    <div>
      <p class="font-display text-2xl font-semibold tracking-tight text-paper">VidMedical</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-fog/75">
        Short medical explainer videos for health practices — animated and clinician-on-camera —
        ready to post on social.
      </p>
    </div>
    <div class="flex flex-col gap-3 text-sm">
      <a href="/packages" class="text-fog/85 no-underline hover:text-signal-bright">Packages</a>
      <a href="/about" class="text-fog/85 no-underline hover:text-signal-bright">About</a>
      <a href="/contact" class="text-fog/85 no-underline hover:text-signal-bright">Contact</a>
      <a href="mailto:hello@vidmedical.com" class="text-fog/85 no-underline hover:text-signal-bright">
        hello@vidmedical.com
      </a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 text-xs text-fog/55 md:flex-row md:justify-between md:px-8">
      <p>© {year} VidMedical. All rights reserved.</p>
      <p>Monthly plans billed via invoice. Prepaid periods are non-refundable.</p>
    </div>
  </div>
</footer>
