---
const pathname = Astro.url.pathname;
const links = [
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#process', label: 'Process' },
  { href: '/about', label: 'About' },
  { href: '/#start', label: 'Contact' },
];
---

<header class="relative z-20 border-b border-ink/8 bg-paper/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 md:px-8">
    <a href="/" class="group flex items-center gap-2.5 no-underline sm:gap-3">
      <img
        src="/brand/vidmedical-mark.svg"
        alt=""
        width="36"
        height="36"
        class="h-8 w-8 shrink-0 rounded-[0.55rem] sm:h-9 sm:w-9"
      />
      <span class="font-display text-lg font-semibold tracking-tight text-ink sm:text-xl md:text-2xl">
        VidMedical{' '}
        <span class="font-sans text-[0.92em] font-medium tracking-[0.02em] text-ink-soft">Studio</span>
      </span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Primary">
      {
        links.map((link) => {
          const active =
            link.href.startsWith('/#')
              ? false
              : pathname === link.href || pathname.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              class:list={[
                'rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors no-underline sm:px-3',
                active ? 'text-signal' : 'text-ink-soft hover:text-signal',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href="/#start"
        class="ml-1 hidden rounded-full bg-ink px-3.5 py-2 text-sm font-medium text-paper no-underline transition hover:bg-ink-soft sm:inline-flex"
      >
        Get started
      </a>
    </nav>
  </div>
</header>
